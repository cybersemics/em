{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    // @vercel/node applies defaults before resolving `extends`, so these inherited root options must be explicit.
    // https://github.com/vercel/vercel/issues/15332
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "target": "es2018"
  }
}
