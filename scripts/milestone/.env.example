# node scripts/milestone/src/issue.ts <issue-number> [--dry]
# GITHUB_TOKEN is required to assign a milestone or post a comment. Reading milestones and issues
# from a public repository works without it, so --dry runs need no token at all.
GITHUB_TOKEN=
# OpenAI API key used for the milestone selection inference call.
OPENAI_API_KEY=
# Repository to operate on. Defaults to cybersemics/em; in Actions it comes from GITHUB_REPOSITORY.
# MILESTONE_REPO=cybersemics/em
# Inference tuning (all optional; defaults shown):
# MILESTONE_MODEL=gpt-5.6-terra           # OpenAI model used for milestone selection.
# MILESTONE_VOTES=5                        # Self-consistency samples drawn per selection (Chat Completions `n`).
# MILESTONE_REASONING_EFFORT=              # Reasoning effort for reasoning models (none|low|medium|high|xhigh|max). Sent only when set.
# MILESTONE_TEMPERATURE=                   # Sent only when set; most reasoning models reject a non-default temperature.
# Evaluation:
# MILESTONE_MIN_ACCURACY=0.8               # yarn evaluate exits non-zero below this exact-match accuracy.
